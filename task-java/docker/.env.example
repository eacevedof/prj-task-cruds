# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la API (http://localhost:9700).
HTTP_PORT=9700

# Puerto del host para el buzon de Mailpit (http://localhost:9725).
MAILPIT_PORT=9725

# TZ de los contenedores.
TIME_ZONE=UTC
