# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la API (http://localhost:9800).
HTTP_PORT=9800

# Puerto del host para el buzon de Mailpit (http://localhost:9825).
MAILPIT_PORT=9825

# TZ de los contenedores.
TIME_ZONE=UTC
