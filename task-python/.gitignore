.vscode
.idea

.env
.env.local
.env.prod
.env.test
.env.dev
docker/.env

# entornos virtuales (la API corre en el contenedor; si se crea uno en el host: .venv-linux / .venv-wsl / .venv-win)
.venv*/
__pycache__/
*.pyc

# storage: ignore generated cache/logs but keep the folder skeleton
storage/**/*
!storage/**/
!storage/**/.gitkeep

# BD SQLite local (se genera con make migrate) y las de los tests
database/*.sqlite*
