# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la SPA (http://localhost:9200).
HTTP_PORT=9200

# APIs que consume la SPA (se elige en la interfaz). Las sirve nginx en /config.json y entran en la CSP.
API_BASE_URL_PHP=http://localhost:9100
API_BASE_URL_GO=http://localhost:9300

# TZ del contenedor.
TIME_ZONE=UTC
