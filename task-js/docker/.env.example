# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la SPA (http://localhost:9200).
HTTP_PORT=9200

# API que consume la SPA (de momento task-php). La sirve nginx en /config.json y entra en la CSP.
API_BASE_URL=http://localhost:9100

# TZ del contenedor.
TIME_ZONE=UTC
