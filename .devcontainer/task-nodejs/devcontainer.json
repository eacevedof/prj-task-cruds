// Dev Containers: VS Code dentro de task-nodejs-app para usar su mismo Node (24.22.1), no el del host.
// Reutiliza el compose del proyecto (name: task-nodejs), asi que comparte contenedores con "make up".
{
    "name": "task-nodejs",
    "dockerComposeFile": ["../../task-nodejs/docker/docker-compose.yml"],
    "service": "task-nodejs-app",
    "runServices": ["task-nodejs-app", "task-nodejs-mailpit"],
    "workspaceFolder": "/app",
    "shutdownAction": "none",

    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "sh",
                "terminal.integrated.profiles.linux": {
                    "sh": { "path": "/bin/sh" }
                }
            }
        }
    }
}
