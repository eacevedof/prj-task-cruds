// Dev Containers: VS Code dentro de task-go-app para usar su mismo Go (1.26.4), no el del host.
// Reutiliza el compose del proyecto (name: task-go), asi que comparte contenedores con "make up".
{
    "name": "task-go",
    "dockerComposeFile": ["../../task-go/docker/docker-compose.yml"],
    "service": "task-go-app",
    "runServices": ["task-go-app", "task-go-mailpit"],
    "workspaceFolder": "/app",
    "shutdownAction": "none",

    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go"
            ],
            "settings": {
                "go.toolsManagement.autoUpdate": false,
                "terminal.integrated.defaultProfile.linux": "sh",
                "terminal.integrated.profiles.linux": {
                    "sh": { "path": "/bin/sh" }
                }
            }
        }
    }
}
