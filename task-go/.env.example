# task-go/.env  (cp .env.example .env, o make env)
APP_ENV=local
APP_DEBUG=0
APP_DEFAULT_LANG=es
APP_DOMAIN=localhost:9300
APP_SQLITE_PATH=%PATH_ROOT%/database/task_cruds.sqlite

APP_LOG_PATH=%PATH_ROOT%/storage/logs
APP_NAME=task-cruds-go

# url publica de la API (ejemplos de la documentacion /api/v1)
APP_BASE_URL=http://localhost:9300

# emails de alerta (MailTrait: un 500 manda el error). Vacio APP_EMAIL_TO = alertas desactivadas.
# En local llegan al buzon de Mailpit: http://localhost:9325
APP_EMAIL_TO=dev@task-go.loc
APP_EMAIL_FROM=alerts@task-go.loc
# el sendmail_path del php.ini de task-php: el sendmail de busybox del contenedor entrega a Mailpit
APP_SENDMAIL_PATH=/usr/sbin/sendmail -t -i -S cont-task-go-mailpit:1025
