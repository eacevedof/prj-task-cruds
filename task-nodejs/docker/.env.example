# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la API (http://localhost:9600).
HTTP_PORT=9600

# Puerto del host para el buzon de Mailpit (http://localhost:9625).
MAILPIT_PORT=9625

# TZ de los contenedores.
TIME_ZONE=UTC
