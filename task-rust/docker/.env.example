# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la API (http://localhost:9500).
HTTP_PORT=9500

# Puerto del host para el buzon de Mailpit (http://localhost:9525).
MAILPIT_PORT=9525

# TZ de los contenedores.
TIME_ZONE=UTC
