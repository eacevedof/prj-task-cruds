# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para nginx (http://localhost:9100).
HTTP_PORT=9100

# Puerto del host para el buzon de Mailpit (http://localhost:9125).
MAILPIT_PORT=9125

# TZ de los contenedores.
TIME_ZONE=UTC
