# task-php/.env.local
APP_ID_CONTEXT=c1
APP_ENV=local
APP_DEBUG=0
APP_DEFAULT_LANG=es
APP_DB_ALIAS_1=db-task-cruds
APP_DOMAIN=localhost:900
APP_CONTEXTS=%PATH_SRC_CONFIG%/contexts.local.json
APP_ENCDECRYPT=%PATH_SRC_CONFIG%/encdecrypt.local.json
APP_SQLITE_PATH=%PATH_ROOT%/database/task_cruds.sqlite

APP_LOG_PATH=%PATH_ROOT%/storage/logs
APP_NAME=task-cruds

# url publica de la API (ejemplos de la documentacion /api/v1/documentation)
APP_BASE_URL=http://localhost:9100

# emails de alerta (MailTrait: un 500 manda el error). Vacio APP_EMAIL_TO = alertas desactivadas.
# En local llegan al buzon de Mailpit: http://localhost:9125
APP_EMAIL_TO=dev@task-php.loc
APP_EMAIL_FROM=alerts@task-php.loc
