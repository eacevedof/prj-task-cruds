{
    "name": "eacevedof/task-php",
    "description": "task-cruds: to-do list CRUD en DDD, solo API, SQLite (implementacion maestra en PHP)",
    "type": "project",
    "license": "proprietary",
    "autoload":{
        "psr-4": {
            "App\\" : "src/"
        },
        "files": [
          "src/Core/config/global.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.12"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
